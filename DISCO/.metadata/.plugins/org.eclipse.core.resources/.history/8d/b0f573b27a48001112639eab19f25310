#include <stm32f4xx_hal.h>
#include <stm32f429i_discovery.h>
#include <stm32f429i_discovery_lcd.h>
#include <cstdio>
#include <stm32f429i_discovery_ts.h>
#include <string>

#define LINE_TOUCH 0

int main(void)
{
	BSP_LED_Init(LED4);
	BSP_LCD_Init();

	BSP_LCD_SetBackColor(LCD_COLOR_BLUE);
	BSP_LCD_SetTextColor(LCD_COLOR_GREEN);

	int iXPos = BSP_LCD_GetXSize();
	int iYPos = BSP_LCD_GetYSize();

	BSP_TS_Init(iXPos, iYPos);

	std::string sText;

	TS_StateTypeDef sTouchDetect;

	while (true) {


		BSP_TS_GetState(&sTouchDetect);

		if(sTouchDetect.TouchDetected == 0) {
			sText = "***************";
		} else {
			sText = "X=" + std::to_string(iXPos) + "; Y=" + std::to_string(iYPos);
		}

		BSP_LCD_DisplayStringAtLine(LINE_TOUCH, reinterpret_cast<uint8_t*>(const_cast<char*>(sText.c_str())));

		HAL_Delay(200);

		BSP_LCD_ClearStringLine(LINE_TOUCH);
	}
}
