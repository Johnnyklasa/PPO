#include <stm32f4xx_hal.h>
#include <stm32f429i_discovery.h>
#include <stm32f429i_discovery_lcd.h>

#define XPOS 10
#define YPOS 20
#define HEIGHT 40
#define WIDTH 30



int main(void)
{
	BSP_LCD_Init();
	while (true) {
		BSP_LCD_SetBackColor(LCD_COLOR_DARKBLUE);
		BSP_LCD_DisplayChar('A');
		HAL_Delay(1000);
		BSP_LCD_DisplayChar('B');
		HAL_Delay(1000);
	}
}
