#include "LedBoard.h"
#include "Led.h"
#include "Keyboard.h"


LedBoard::LedBoard (unsigned char ucColumn){
	BSP_LCD_Init();
	BSP_LCD_SetFont(&Font24);
	for (unsigned char ucLedCounter=0; ucLedCounter<LedNumber; ucLedCounter++){
		Leds.push_back(new Led(ucColumn, ucLedCounter));
	}
}




void LedBoard::On(unsigned char ucLed){
		Off();
		if(ucLed!=4){
		Leds[ucLed]->On();
		}
}


void LedBoard::Off(){
	for (std::vector<Led*>::iterator it = Leds.begin(); it != Leds.end(); ++it) {
	        // 'it' zachowuje się jak wskaźnik na element wektora.
	        // Skoro elementem jest wskaźnik (Led*), to musimy go najpierw
	        // wyłuskać (*it), a potem wywołać metodę (->Off())
	        (*it)->Off();
	    }
}

