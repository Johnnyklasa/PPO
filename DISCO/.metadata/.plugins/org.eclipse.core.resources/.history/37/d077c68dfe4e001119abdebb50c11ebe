#include <stm32f4xx_hal.h>
#include "KeyboardTsLcd.h"

int main()
{

	KeyboardTsLcd Keyboard(0);
	LedLcd Led(2);
	while(true) {
		switch(Keyboard.eRead()){

		case BUTTON_0:
			Led.On(3);
			break;

		case BUTTON_1:
			Led.On(2);
			break;

		case BUTTON_2:
			Led.On(1);
			break;

		case BUTTON_3:
			Led.On(0);
			break;
		}

		}
		HAL_Delay(100);
	}
}


