#include <stm32f4xx_hal.h>
#include <stm32f429i_discovery.h>
#include <stm32f429i_discovery_lcd.h>
#include <cstdio>
#include <stm32f429i_discovery_ts.h>

int main(void)
{
	BSP_LCD_Init();
	BSP_LCD_SetBackColor(LCD_COLOR_BLUE);
	BSP_LCD_SetTextColor(LCD_COLOR_GREEN);
	BSP_TS_Init(240, 320);

	TS_StateTypeDef CheckPress;
	char cPosition[30]; // Zwiększony bufor
	const char *cString;
	unsigned int uiXSize;
	unsigned int uiYSize;
	float fXPercent; // Zmienne na ułamki
	float fYPercent;

	while (true) {
		BSP_LCD_Clear(LCD_COLOR_BLACK);
		BSP_TS_GetState(&CheckPress);

		uiXSize = CheckPress.X;
		uiYSize = CheckPress.Y;

		// Obliczanie procentów
		fXPercent = ((float)uiXSize / 240.0f) * 100.0f;
		fYPercent = ((float)uiYSize / 320.0f) * 100.0f;

		if(CheckPress.TouchDetected > 0){
			// Szablon z floatami i znakami procenta
			cString = "X=%.2f%%; Y=%.2f%%";
		}
		else { // Uprościłem Twojego if-else
			cString = "*************";
		}

		// Przekazujemy zmienne fXPercent i fYPercent zamiast uiXSize
		sprintf(cPosition, cString, fXPercent, fYPercent);
		BSP_LCD_DisplayStringAt(10, 20, (uint8_t *)cPosition, LEFT_MODE);
		HAL_Delay(100);
	}
}
