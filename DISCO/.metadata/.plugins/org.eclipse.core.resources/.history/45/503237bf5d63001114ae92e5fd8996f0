	}
}




void LedBoard::On(unsigned int uiLedCtr){
		if (uiLedCtr==uiCurrOn){
			return;
		}
		if (uiCurrOn!=NONE){
			DrawButton(LCD_COLOR_BLUE, uiCurrOn); //sciagamy palucha
		}
		if (uiLedCtr!=NONE){
			DrawButton(LCD_COLOR_GREEN, uiLedCtr); //kladziemy palucha
		}
		uiCurrOn = uiLedCtr;
}
void LedBoard::Off(){
	On(NONE);
}

