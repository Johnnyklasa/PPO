#define XPOS 10
#define YPOS 20
#define HEIGHT 40
#define WIDTH 30


void     BSP_LCD_DrawRect(uint16_t Xpos, uint16_t Ypos, uint16_t Width, uint16_t Height);

int main(void)
{

	while (true) {
		BSP_LCD_DrawRect(10,20,40,30);
