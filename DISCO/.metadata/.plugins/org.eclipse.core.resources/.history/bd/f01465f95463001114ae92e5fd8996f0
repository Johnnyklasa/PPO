#include <stm32f4xx_hal.h>

#include "KeyboardLed.h"

int main()
{

	KeyboardLed Keyboard(0);
	LedBoard Led(2);
	while(true) {
		case BUTTON_3:
		LedBoard->On(0);
		break;
	default : LedBoard->Off(); // <- !!!
		break;
		ButtonState eState = Keyboard.eRead();
		if (eState!=NONE){
			Led.On(3-eState);
		}
		else {
			Led.On(NONE);
		}

	HAL_Delay(100);
	}
}


