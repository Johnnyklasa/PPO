#include "ledlcd.h"
#include "KeyboardTs.h"

LedLcd::LedLcd(){

	uiCurrOn =NONE;
	unsigned int uiLCDHeight = BSP_LCD_GetYSize();
	unsigned int uiButtonCounter;
	for (uiButtonCounter = 0; uiButtonCounter < uiLCDHeight; uiCurrentRectPosY = uiCurrentRectPosY + RectHigh) {
		  DrawButton(0,uiCurrentRectPosY , RectWidth, RectHigh, LCD_COLOR_BLUE, LCD_COLOR_GREEN,0);
	}
}


void  LedLcd::On(unsigned int uiLedCtr){
		if (uiLedCtr==uiCurrOn){
			return;
		}
		else if (uiCurrOn!=NONE){
			DrawButton(0, uiCurrOn * RectHigh, RectWidth, RectHigh, LCD_COLOR_BLUE, LCD_COLOR_GREEN, eCurrent_Button);
		}
		if (uiLedCtr!=NONE){
			DrawButton(0, uiLedCtr * RectHigh, RectWidth, RectHigh, LCD_COLOR_GREEN, LCD_COLOR_GREEN, eCurrent_Button);
		}
		uiCurrOn = uiLedCtr;
}

