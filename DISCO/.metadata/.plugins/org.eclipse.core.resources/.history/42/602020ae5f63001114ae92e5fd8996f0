#include "LedBoard.h"
#include "Led.h"
#include "Keyboard.h"


LedBoard::LedBoard (unsigned char ucColumn){
	BSP_LCD_Init();
	BSP_LCD_SetFont(&Font24);
	for (unsigned char ucLedCounter=0; ucLedCounter<LedNumber; ucLedCounter++){
		Leds[ucLedCounter] = new Led(ucColumn,ucLedCounter);
	}
}




void LedBoard::On(unsigned int uiLedCtr){
		for (unsigned char ucLedCounter=0; ucLedCounter<LedNumber; ucLedCounter++){

		}




		if (uiLedCtr==uiCurrOn){
			return;
		}
		if (uiCurrOn!=NONE){
			DrawButton(LCD_COLOR_BLUE, uiCurrOn); //sciagamy palucha
		}
		if (uiLedCtr!=NONE){
			DrawButton(LCD_COLOR_GREEN, uiLedCtr); //kladziemy palucha
		}
		uiCurrOn = uiLedCtr;
}
void LedBoard::Off(){
	On(NONE);
}

