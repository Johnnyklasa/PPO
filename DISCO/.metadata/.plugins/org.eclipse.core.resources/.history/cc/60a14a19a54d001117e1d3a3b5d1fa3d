#include <stm32f4xx_hal.h>
#include <stm32f429i_discovery.h>
#include <stm32f429i_discovery_lcd.h>
#include <stm32f429i_discovery_ts.h>

#define RectWidth 80
#define RectHigh 80


enum ButtonState {
	NONE = -1,
	BUTTON0 = 0,
	BUTTON1 = 1,
	BUTTON2 = 2,
	BUTTON3 = 3};


void DrawButton(uint16_t Xpos, uint16_t Ypos, uint16_t Width, uint16_t Height, uint32_t FillColor, uint32_t BorderColor){
	BSP_LCD_SetTextColor(FillColor);
	BSP_LCD_FillRect(Xpos, Ypos, Width, Height);
	BSP_LCD_SetTextColor(BorderColor);
	BSP_LCD_DrawRect(Xpos, Ypos, Width, Height);
	BSP_LCD_SetTextColor(LCD_COLOR_WHITE); // Kolor samej cyfry (np. biały)
	BSP_LCD_SetBackColor(FillColor);

}

void DrawFilledRectWithBorder(uint16_t Xpos, uint16_t Ypos, uint16_t Width, uint16_t Height, uint32_t FillColor, uint32_t BorderColor)
{
  BSP_LCD_SetTextColor(FillColor);
  BSP_LCD_FillRect(Xpos, Ypos, Width, Height);
  BSP_LCD_SetTextColor(BorderColor);
  BSP_LCD_DrawRect(Xpos, Ypos, Width, Height);
}




void ButtonInit(){
	unsigned int uiLCDHeight = BSP_LCD_GetYSize();
	unsigned int uiCurrentRectPosY =0;
	for (uiCurrentRectPosY=  0; uiCurrentRectPosY < uiLCDHeight; uiCurrentRectPosY = uiCurrentRectPosY + RectHigh) {
	            DrawFilledRectWithBorder(0,uiCurrentRectPosY , RectWidth, RectHigh, LCD_COLOR_BLUE, LCD_COLOR_GREEN);
	  }
}
void LCDInit(){
	BSP_LCD_Init();
    unsigned int uiLCDWidth = BSP_LCD_GetXSize();
    unsigned int uiLCDHeight = BSP_LCD_GetYSize();

    BSP_TS_Init(uiLCDWidth, uiLCDHeight);
}

enum ButtonState eRead(){
    TS_StateTypeDef sDetector;
	 BSP_TS_GetState(&sDetector);
	 if ((sDetector.TouchDetected > 0 ) && (sDetector.X <= RectWidth)) {
		 ButtonState eCurrButtonState = static_cast<ButtonState>(sDetector.Y/RectHigh);
		 return eCurrButtonState;
	 }
	return NONE;

}



int main(){
	LCDInit();
	ButtonInit();

	ButtonState eCurrent_Button = NONE;
	ButtonState eLast_Button = NONE;
    while (true){
    	eCurrent_Button=eRead();
    	if (eCurrent_Button!=eLast_Button){
    		if(eLast_Button != NONE){
    		DrawFilledRectWithBorder(0, eLast_Button * RectHigh, RectWidth, RectHigh, LCD_COLOR_BLUE, LCD_COLOR_GREEN);
    	}
    		if(eCurrent_Button != NONE ){
    		DrawFilledRectWithBorder(0, eCurrent_Button * RectHigh, RectWidth, RectHigh, LCD_COLOR_GREEN, LCD_COLOR_GREEN);
    	}
    	eLast_Button=eCurrent_Button;


    }
    	HAL_Delay(100);
   }
}






