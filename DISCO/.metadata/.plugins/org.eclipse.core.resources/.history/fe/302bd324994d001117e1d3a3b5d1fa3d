#include <stm32f4xx_hal.h>
#include <stm32f429i_discovery.h>
#include <stm32f429i_discovery_lcd.h>
#include <stm32f429i_discovery_ts.h>

#define RectWidth 80
#define RectHigh 80

#define FirstRectPos 0
#define SecondRectPos 80
#define ThirdRectPos 160
#define FourthRectPos 240


#define RectX 80


void DrawFilledRectWithBorder(uint16_t Xpos, uint16_t Ypos, uint16_t Width, uint16_t Height, uint32_t FillColor, uint32_t BorderColor)
{
  BSP_LCD_SetTextColor(FillColor);
  BSP_LCD_FillRect(Xpos, Ypos, Width, Height);
  BSP_LCD_SetTextColor(BorderColor);
  BSP_LCD_DrawRect(Xpos, Ypos, Width, Height);
}


int main(){
    TS_StateTypeDef sDetector;
    unsigned int uiWidth = BSP_LCD_GetXSize();
    unsigned int uiHeight = BSP_LCD_GetYSize();
    unsigned int uiRect = 0;

    BSP_LCD_Init();
    BSP_TS_Init(uiWidth, uiHeight);

    for (int i = 0; i < uiHeight; i = i + RectHigh) {
        DrawFilledRectWithBorder(0, i, RectWidth, RectHigh, LCD_COLOR_BLUE, LCD_COLOR_GREEN);
    }

    while (true){
        BSP_TS_GetState(&sDetector);
        if (sDetector.TouchDetected > 0) {
            if (sDetector.X <= RectX) {
                uiRect = (sDetector.Y /RectHigh);

                switch (uiRect) {
                    case 0:
                        DrawFilledRectWithBorder(0, FirstRectPos, RectWidth, RectHigh, LCD_COLOR_GREEN, LCD_COLOR_GREEN);
                        break;

                    case 1:
                    	DrawFilledRectWithBorder(0, SecondRectPos, RectWidth, RectHigh, LCD_COLOR_GREEN, LCD_COLOR_GREEN);
                        break;

                    case 2:
                        DrawFilledRectWithBorder(0, ThirdRectPos, RectWidth, RectHigh, LCD_COLOR_GREEN, LCD_COLOR_GREEN);
                        break;

                    case 3:
                        DrawFilledRectWithBorder(0, ForthRectPos, RectWidth, RectHigh, LCD_COLOR_GREEN, LCD_COLOR_GREEN);
                        break;
                }
            }
        }

        HAL_Delay(100);
    }
}





