#include "KeyboardTsLcd.h"
#include <stm32f429i_discovery.h>
#include <stm32f429i_discovery_lcd.h>
#include <stm32f429i_discovery_ts.h>


KeyboardTsLcd::KeyboardTsLcd(unsigned int ucColumn) {
	pKeyboard = new KeyboardTs(ucColumn);
	pLed = new LedLcd(ucColumn);
}


ButtonState KeyboardTsLcd::eRead(){
     TS_StateTypeDef sDetector;
	 BSP_TS_GetState(&sDetector);
	 if ((sDetector.TouchDetected > 0 ) && (sDetector.X >= RectWidth * pKeyboard->uiButtonColumn) && (sDetector.X <= RectWidth * (ucColumn +1))) {
		 ButtonState eCurrButtonState = static_cast<ButtonState>(sDetector.Y/RectHigh);
		 return eCurrButtonState;
	 }
	return NONE;

}

